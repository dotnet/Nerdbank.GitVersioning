<!--
  Mono dllmap for LibGit2Sharp native libraries.
  Must match libgit2_filename from LibGit2Sharp.NativeBinaries (git2-5853918 for 2.0.324).
  Upstream NativeBinaries 2.0.324 still ships maps for the previous hash; we ship a corrected copy.
-->
<configuration>
    <dllmap os="linux" cpu="x86-64" wordsize="64" dll="git2-5853918" target="lib/linux-x64/libgit2-5853918.so" />
    <dllmap os="linux" cpu="arm" wordsize="32" dll="git2-5853918" target="lib/linux-arm/libgit2-5853918.so" />
    <dllmap os="linux" cpu="armv8" wordsize="64" dll="git2-5853918" target="lib/linux-arm64/libgit2-5853918.so" />
    <dllmap os="linux" cpu="ppc64le" wordsize="64" dll="git2-5853918" target="lib/linux-ppc64le/libgit2-5853918.so" />
    <dllmap os="osx" cpu="x86-64" wordsize="64" dll="git2-5853918" target="lib/osx-x64/libgit2-5853918.dylib" />
    <dllmap os="osx" cpu="armv8" wordsize="64" dll="git2-5853918" target="lib/osx-arm64/libgit2-5853918.dylib" />
</configuration>
